# ---------- Shared (web + ws) ----------
DATABASE_URL="postgresql://chat:chat@localhost:5432/chat?schema=public"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ---------- Web ----------
WS_INTERNAL_URL="http://localhost:4001"

# ---------- WS server ----------
WS_PORT=4001
ORIGIN="http://localhost:3000"

# ---------- Storage (local provider needs nothing) ----------
STORAGE_PROVIDER="local"
# HMAC secret for signed local media URLs (falls back to NEXTAUTH_SECRET)
# STORAGE_SECRET="change-me"

MEDIA_DIR="./.data/media"
# S3 (optional)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
